+static uint16_t smbios_cache_configuration(unsigned int level,
+                                           unsigned int associativity)
+{
+    /*
+     * bits 0-2: cache level
+     * bit  3  : socketed (no)
+     * bits 5-6: location (0 = internal)
+     * bit  7  : enabled
+     * bits 8-9: mode (1 = write-back)
+     * bits 12-15: associativity
+     */
+    return (level & 0x7) | (1u << 7) | (1u << 8) |
+           ((associativity & 0xf) << 12);
+}
+
+static void smbios_build_type_7_cache(unsigned int handle, const char *name,
+                                      unsigned int level,
+                                      unsigned int size_kb,
+                                      unsigned int associativity,
+                                      unsigned int cache_type)
+{
+    SMBIOS_BUILD_TABLE_PRE(7, handle, true);
+
+    SMBIOS_TABLE_SET_STR(7, socket_designation_str, name);
+    t->cache_configuration =
+        cpu_to_le16(smbios_cache_configuration(level, associativity));
+    t->maximum_cache_size = cpu_to_le16(size_kb);
+    t->installed_size = cpu_to_le16(size_kb);
+    t->supported_sram_type = cpu_to_le16(0x0020); /* Synchronous */
+    t->current_sram_type = cpu_to_le16(0x0020);
+    t->cache_speed = 1; /* 1 ns */
+    t->error_correction_type = 0x05; /* Single-bit ECC */
+    t->system_cache_type = cache_type;
+    t->associativity = associativity;
+    t->maximum_cache_size_2 = cpu_to_le32(size_kb);
+    t->installed_size_2 = cpu_to_le32(size_kb);
+
+    SMBIOS_BUILD_TABLE_POST;
+}
+
+static void smbios_build_type_7_table(void)
+{
+    /* L1 instruction: 32 KiB, 8-way */
+    smbios_build_type_7_cache(0x0700, "L1 Instruction Cache", 1, 32, 5, 0x03);
+    /* L1 data: 32 KiB, 8-way */
+    smbios_build_type_7_cache(0x0701, "L1 Data Cache", 1, 32, 5, 0x04);
+    /* L2: 8 MiB, 16-way */
+    smbios_build_type_7_cache(0x0702, "L2 Cache", 2, 8192, 6, 0x05);
+    /* L3: 16 MiB, 16-way */
+    smbios_build_type_7_cache(0x0703, "L3 Cache", 3, 16384, 6, 0x05);
+}
